// log_triage.crush — an agent-written tool: summarise a directory of logs.
//
// Written by Claude (Opus 5.5) as the kind of small tool an agent writes for
// a user and runs without a human reading every line first. What makes that
// safe in Crush is the declaration below plus the host's grants:
//
//   crush-run caps log_triage.crush                      # what it can touch, without running it
//   crush-run run log_triage.crush                       # refused up front: no grants
//   crush-run run --fs --fs-root sample-logs --time log_triage.crush
//
// It reads every *.log file in the directory it is given (--fs-root) and
// prints, per file, how many INFO / WARN / ERROR lines it has, then the
// distinct ERROR messages across all files, most frequent first.
//
// It cannot write files, read anything outside --fs-root, open a network
// connection or spawn a process: none of those is declared, so the program
// would not compile if it tried, and none is granted.

@capabilities [fs.list, fs.cat, time.now_iso]

// Lines of `text` that contain ` LEVEL `.
fn count_level(lines, level) {
    let tag = " " + level + " "
    let n = 0
    let i = 0
    while i < len(lines) {
        if str.contains(lines[i], tag) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Position of `msg` in `msgs`, or -1.
fn find(msgs, msg) {
    let i = 0
    while i < len(msgs) {
        if msgs[i] == msg {
            return i
        }
        i = i + 1
    }
    return -1
}

// Index of the largest count not yet printed (counts set to -1 once printed).
fn largest(counts) {
    let best = -1
    let i = 0
    while i < len(counts) {
        if counts[i] >= 0 {
            if best < 0 {
                best = i
            } else {
                if counts[i] > counts[best] {
                    best = i
                }
            }
        }
        i = i + 1
    }
    return best
}

fn main() {
    io.print("log triage — " + time.now_iso())
    io.print("")

    let names = fs.list(".")
    let msgs = []
    let counts = []
    let files = 0
    let total_errors = 0

    let f = 0
    while f < len(names) {
        let name = names[f]
        if str.ends_with(name, ".log") {
            files = files + 1
            let lines = str.split(fs.cat(name), "\n")
            let errors = count_level(lines, "ERROR")
            total_errors = total_errors + errors
            let info = str.pad_left(str.concat(count_level(lines, "INFO")), 3, " ")
            let warn = str.pad_left(str.concat(count_level(lines, "WARN")), 3, " ")
            let err = str.pad_left(str.concat(errors), 3, " ")
            io.print(str.pad_right(name, 14, " ") + " info " + info + "  warn " + warn + "  error " + err)

            let i = 0
            while i < len(lines) {
                if str.contains(lines[i], " ERROR ") {
                    let msg = str.trim(str.split(lines[i], " ERROR ")[1])
                    let at = find(msgs, msg)
                    if at < 0 {
                        msgs.push(msg)
                        counts.push(1)
                    } else {
                        counts[at] = counts[at] + 1
                    }
                }
                i = i + 1
            }
        }
        f = f + 1
    }

    io.print("")
    if files == 0 {
        io.print("no .log files found")
        return 0
    }
    let summary = str.concat(files) + " files, " + str.concat(total_errors) + " errors"
    io.print(summary + ", " + str.concat(len(msgs)) + " distinct:")
    let k = largest(counts)
    while k >= 0 {
        io.print("  " + str.pad_left(str.concat(counts[k]), 3, " ") + "x  " + msgs[k])
        counts[k] = -1
        k = largest(counts)
    }
    return 0
}
